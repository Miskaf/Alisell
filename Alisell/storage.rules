rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{f} { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
    match /listings/{uid}/{f} { allow read: if true; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
    // Verification documents are private; admins view them through signed URLs from a Cloud Function.
    match /verification/{uid}/{f} { allow read: if false; allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024; }
  }
}
